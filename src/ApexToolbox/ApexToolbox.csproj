<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Apex Toolbox</AssemblyName>
    <RootNamespace>ApexToolbox</RootNamespace>
    <ApplicationIcon>Assets/ApexToolboxApplication.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Product>Apex OS</Product>
    <AssemblyTitle>Apex Toolbox</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../config/toolbox.json" Link="Toolbox/config/toolbox.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../config/protected-components.json" Link="Toolbox/config/protected-components.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/**/*" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/**/*.ps1" Link="scripts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../scripts/**/*.psm1" Link="scripts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CreateApexInstallLayout" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Tools;$(PublishDir)Packages;$(PublishDir)Wallpapers;$(PublishDir)Backups;$(PublishDir)Logs;$(PublishDir)Toolbox/ConfigurationServices;$(PublishDir)Toolbox/Scripts;$(PublishDir)Toolbox/Registry;$(PublishDir)Toolbox/Logs;$(PublishDir)Toolbox/config;$(PublishDir)Scripts/Performance;$(PublishDir)Scripts/Gaming;$(PublishDir)Scripts/RAMSaver;$(PublishDir)Scripts/Power;$(PublishDir)Scripts/Drivers;$(PublishDir)Scripts/Network;$(PublishDir)Scripts/Windows;$(PublishDir)Scripts/Explorer;$(PublishDir)Scripts/Security;$(PublishDir)Scripts/Repair;$(PublishDir)Scripts/Diagnostics;$(PublishDir)Scripts/Privacy;$(PublishDir)Scripts/Personalization;$(PublishDir)Scripts/Modules" />
  </Target>
</Project>